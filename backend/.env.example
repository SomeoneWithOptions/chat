PORT=8080
APP_ENV=development
FRONTEND_ORIGIN=https://chat.sanetomore.com
CORS_ALLOWED_ORIGINS=https://chat.sanetomore.com,http://localhost:5173,http://localhost:4173
COOKIE_SECURE=false
SESSION_COOKIE_NAME=chat_session
SESSION_TTL_HOURS=720
ALLOWED_GOOGLE_EMAILS=acastesol@gmail.com,obzen.black@gmail.com
GOOGLE_CLIENT_ID=
AUTH_REQUIRED=true
AUTH_INSECURE_SKIP_GOOGLE_VERIFY=false
MODEL_SYNC_BEARER_TOKEN=replace-with-30-char-random-token
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_TIER_DEFAULT_MODEL=openrouter/free
DEFAULT_CHAT_REASONING_EFFORT=medium
DEFAULT_DEEP_RESEARCH_REASONING_EFFORT=high
BRAVE_API_KEY=
BRAVE_API_BASE_URL=https://api.search.brave.com/res/v1
LOCAL_UPLOAD_DIR=/tmp/chat-uploads
GCS_UPLOAD_BUCKET=
GCS_UPLOAD_PREFIX=chat-uploads
DEEP_RESEARCH_TIMEOUT_SECONDS=150
AGENTIC_RESEARCH_CHAT_ENABLED=true
AGENTIC_RESEARCH_DEEP_ENABLED=true
CHAT_RESEARCH_MAX_LOOPS=2
CHAT_RESEARCH_MAX_SOURCES_READ=4
CHAT_RESEARCH_MAX_SEARCH_QUERIES=4
CHAT_RESEARCH_TIMEOUT_SECONDS=20
DEEP_RESEARCH_MAX_LOOPS=6
DEEP_RESEARCH_MAX_SOURCES_READ=16
DEEP_RESEARCH_MAX_SEARCH_QUERIES=18
RESEARCH_SOURCE_FETCH_TIMEOUT_SECONDS=12
RESEARCH_SOURCE_MAX_BYTES=1500000
RESEARCH_MAX_CITATIONS_CHAT=8
RESEARCH_MAX_CITATIONS_DEEP=12
AGENT_MODE_ENABLED=true
AGENT_MIN_SEARCH_QUERIES=20
AGENT_SOFT_MAX_SEARCH_QUERIES=60
AGENT_HARD_MAX_SEARCH_QUERIES=200
AGENT_MAX_SOURCES_READ=80
AGENT_TIMEOUT_SECONDS=1200
COUNCIL_TARGET_READABLE_SOURCES_PER_MODEL=15
COUNCIL_SEARCH_RESULTS_PER_QUERY=15
COUNCIL_MAX_SEARCH_QUERIES_PER_MODEL=4
COUNCIL_TIMEOUT_SECONDS=1200
BRAVE_MONTHLY_QUERY_LIMIT=2000
BRAVE_MONTHLY_QUERY_RESERVE=200
INTERNAL_WORKER_BASE_URL=
INTERNAL_WORKER_BEARER_TOKEN=
